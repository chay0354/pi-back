{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {"maxDuration": 60}
    }
  ],
  "functions": {
    "server.js": {"maxDuration": 60}
  },
  "routes": [{"src": "/(.*)", "dest": "server.js"}],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {"key": "Vary", "value": "Origin"},
        {"key": "Cache-Control", "value": "no-store"}
      ]
    }
  ]
}
